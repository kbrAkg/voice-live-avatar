# Copy: cp .env.example .env  (Windows: Copy-Item .env.example .env)
# This file is an EXAMPLE. Never write real secrets here; only write them into .env.

AZURE_LOCATION=eastus2
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# --- Service user (keyless) credentials ---
# Service principal for local development / CI (output of setup-service-identity.ps1):
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Managed identity clientId for Container Apps (production) (optional, azd sets it automatically):
AZURE_MANAGED_IDENTITY_CLIENT_ID=

ASSISTANT_DOMAIN=education
ASSISTANT_PROFILE=teacher-default
DEFAULT_LANGUAGE=tr-TR

BACKEND_BASE_URL=http://localhost:8081
MCP_BASE_URL=http://localhost:8082

AZURE_SPEECH_RESOURCE_ID=
AZURE_SPEECH_ACCOUNT_NAME=
AZURE_SPEECH_REGION=eastus2
AZURE_SEARCH_SERVICE=
AZURE_SEARCH_INDEX=knowledge-index
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=knowledge
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=

AZURE_OPENAI_ACCOUNT_NAME=
AZURE_OPENAI_RESOURCE_GROUP=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_REALTIME_DEPLOYMENT=

# --- Voice Live API (realtime speech-to-speech) ---
# WebSocket base address. If left empty, AZURE_OPENAI_ENDPOINT is used.
# Voice Live usually requires a cognitiveservices / services.ai.azure.com custom domain.
AZURE_VOICE_LIVE_ENDPOINT=
AZURE_VOICE_LIVE_MODEL=gpt-4o-mini
AZURE_VOICE_LIVE_API_VERSION=2025-05-01-preview
# Barge-in (interruption) detection: azure_semantic_vad | azure_semantic_vad_multilingual
# Note: server_vad CANNOT be used with input_audio_transcription=azure-speech; semantic VAD is required.
AZURE_VOICE_LIVE_VAD=azure_semantic_vad_multilingual

# Authentication mode: service-principal | developer-login
AZURE_AUTH_MODE=service-principal
KNOWLEDGE_USE_AZURE_CLI_CREDENTIAL=false
